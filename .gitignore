# Arduino / arduino-cli build output
firmware/build/
firmware/build_*/
*.uf2
*.elf
*.map
*.hex

# Native simulator build output
firmware/sim/obj/
firmware/sim/sim.exe
firmware/sim/*.pdb
firmware/sim/*.ilk

# Python
__pycache__/
*.pyc
.venv/
venv/

# Captured data and logs (regenerate these, do not commit them)
*.csv.log
soak*.csv
dump*.txt
*_dump.txt

# KiCad transient files
*.kicad_prl
*-backups/
~*.lck
fp-info-cache
*.kicad_pcb-bak
*.kicad_sch-bak
*.net.bak

# KiCad working files from routing and DRC sessions.
# These are intermediate states, not the released design.
# Unanchored on purpose. A pattern containing a slash is matched relative to
# this file, and these live under the KiCad project subdirectory.
_probe.*
*.unrouted-backup
backup-20*/
routed_trial.*
drc_check.rpt
drc_routed.rpt

# VS Code Local History extension.
# These directories contain nested .git repos and will confuse a fresh clone.
.history/

# Editor / OS
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# sim build artefacts
firmware/sim/obj/
firmware/sim/sim
firmware/sim/sim-fixed
firmware/sim/*.exe

# Scratch area for the rev-3 routing tools: freerouting runs, DRC reports,
# stage boards, the grid router binary and the Python deps it needs
# (audit-tools/README.md says how to rebuild it). Hundreds of MB, never committed.
tmp/

# Local recovery points for the rev-3 board. Every edit that touched the board
# left the previous version here; the documents refer to them by directory
# name. They are kept on the working machine, not in the repository.
boards/rev3/backups/

# Intermediate boards and router exchange files that the rev-3 tools write
# beside the real board (rev3.kicad_pcb.<stage>, rev3.dsn, rev3.ses ...).
boards/rev3/rev3.kicad_pcb.*
boards/rev3/*.dsn
boards/rev3/*.dsn.*
boards/rev3/*.ses
boards/rev3/*-mazerouted.kicad_pcb
boards/rev3/GERBER\ OUTPUT/
boards/rev3/tmp/

# pcbnew leaves these beside any board it saves under a new name
*.kicad_pcb.bak
*.kicad_sch.bak
