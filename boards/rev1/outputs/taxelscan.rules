
(rules PCB FlexiTac.dsn
  (snap_angle 
    fortyfive_degree
  )
  (rule
    (width 150.0)
    (clearance 150.0)
    (clearance 75.0 (type smd_to_turn_gap))
    (clearance 37.6 (type smd))
    (clearance 150.0 (type "kicad_default"))
  )
  (padstack "Via[0-3]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle GND 600.0 0.0 0.0)
    )
    (shape
      (circle PWR 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-3]_600:300_um" "Via[0-3]_600:300_um" default
  )
  (via 
    "Via[0-3]_600:300_um-kicad_default" "Via[0-3]_600:300_um" "kicad_default"
  )
  (via_rule
    default "Via[0-3]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-3]_600:300_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 150.0)
    )
    (circuit 
      (use_layer F.Cu GND PWR B.Cu)
    )
  )
  (class "kicad_default"
    GND "ROW_VCC" +3.3V "COL_0" "COL_1" "COL_2" "COL_3" "COL_4"
    "COL_5" "COL_6" "COL_7" "COL_8" "COL_9" "COL_10" "COL_11" "COL_12"
    "COL_13" "COL_14" "COL_15" "COL_16" "COL_17" "COL_18" "COL_19" "COL_20"
    "COL_21" "COL_22" "COL_23" "COL_24" "COL_25" "COL_26" "COL_27" "COL_28"
    "COL_29" "COL_30" "COL_31" "ROW_17" "ROW_18" "ROW_19" "ROW_20" "ROW_21"
    "ROW_22" "ROW_23" "SR_CHAIN_3" "ROW_CLK" "ROW_LATCH" "SR_CHAIN_2" "ROW_16" "ROW_0"
    "ROW_1" "ROW_2" "ROW_3" "ROW_4" "ROW_5" "ROW_6" "ROW_7" "ROW_8"
    "ROW_9" "ROW_10" "ROW_11" "ROW_12" "ROW_13" "ROW_14" "ROW_15" "ROW_24"
    "ROW_25" "ROW_26" "ROW_27" "ROW_28" "ROW_29" "ROW_30" "ROW_31" "ADC_A"
    "ADC_B" "unconnected-(A1-D2{slash}A2{slash}GPIO28-Pad3)" "MUX_S1" "MUX_S2" "MUX_S3" "unconnected-(A1-D6{slash}GPIO0-Pad7)" "ROW_LATCH_MCU" "ROW_CLK_MCU"
    "MUX_S0" "ROW_DATA" +5V "SENSE_A" "unconnected-(U4-QH'-Pad9)" "SENSE_B" "SR_CHAIN_1"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 150.0)
    )
    (circuit 
      (use_layer F.Cu GND PWR B.Cu)
    )
  )
)