(version 1)
# Fine-pitch escape area around the RP2354A (QFN-60, 0.4 mm pitch) and the crystal
# group below it. JLCPCB's 4-layer process allows 0.09 mm track and space; 0.1 is
# used here so every one of the fifteen bottom-row pins can leave beside its
# neighbours' bypass capacitors. Everything outside the area keeps 0.15/0.15.
(rule "qfn escape clearance"
  (condition "A.intersectsArea('U9_escape') && B.intersectsArea('U9_escape')")
  (constraint clearance (min 0.1mm)))
(rule "qfn escape track width"
  (condition "A.intersectsArea('U9_escape')")
  (constraint track_width (min 0.1mm)))
(rule "tusb320 escape clearance"
  (condition "A.intersectsArea('U13_escape') && B.intersectsArea('U13_escape')")
  (constraint clearance (min 0.1mm)))
(rule "tusb320 escape track width"
  (condition "A.intersectsArea('U13_escape')")
  (constraint track_width (min 0.1mm)))
# Outside both escape areas no track is narrower than 0.15 mm (the 21 October review:
# signal widths that change along a net). Board minimum 0.1 mm is for the areas above.
# Four slow nets keep runs of 0.10 mm where no way at 0.15 mm was found (REVIEW.md,
# comment 2): MUX_S0 among the column lines on B.Cu, MUX_S2 / MUX_S3 between the two
# muxes - the selects change once per channel, then sit still through the settle - and
# SYNC_DE beside the transceivers, the master's frame-start enable, pulsed once a frame.
(rule "0.15 mm outside the escape areas"
  (condition "A.Type == 'Track' && !A.intersectsArea('U9_escape') && !A.intersectsArea('U13_escape') && A.NetName != 'MUX_S0' && A.NetName != 'MUX_S2' && A.NetName != 'MUX_S3' && A.NetName != 'SYNC_DE'")
  (constraint track_width (min 0.15mm)))
# No via hole in or within 0.10 mm of an SMD pad of any net (JLCPCB's minimum solder-mask
# bridge), so the board needs no filled vias: the vias are tented and the mask web keeps
# solder out of them. The exposed pads of U9 (RP2354A) and U12 (TPS62162) keep their
# ground vias, as both makers' layouts have them. U5 pin 15 (that mux's enable, tied
# low) had its via at the toe of its pad, boxed in by the column lines; the pad's toe is
# cut back 0.30 mm instead, so the hole is 0.15 mm clear of it (REVIEW.md, comment 1).
# physical_hole_clearance applies across nets; existsOnLayer leaves out the paste-only
# apertures some footprints carry.
(rule "via hole clear of SMD pads"
  (condition "A.Type == 'Via' && B.Type == 'Pad' && B.Pad_Type == 'SMD' && B.existsOnLayer('F.Cu') && !(B.memberOfFootprint('U9') && B.Pad_Number == '61') && !(B.memberOfFootprint('U12') && B.Pad_Number == '9')")
  (constraint physical_hole_clearance (min 0.1mm)))
