  (text "LOW limit: R27 only, about 0.32 A nominal\nHIGH limit: R27 || R28, about 0.63 A nominal\nD4 blocks an externally powered harness from USB."
    (at 299.72 652.78 0)
    (effects (font (size 1.52 1.52)) (justify left))
    (uuid 5dd8f535-0665-47dd-97d4-a8865a360234)
