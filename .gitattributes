# Normalise line endings: text files are stored with LF and checked out per
# the platform. KiCad, Python and Markdown all read either.
* text=auto

# Binary content, never normalised or diffed as text. STEP models are text
# and stay under text=auto, which is how they are already stored.
*.png binary
*.gif binary
*.jpg binary
*.pdf binary
*.zip binary
*.wrl binary
*.exe binary
*.bin binary
